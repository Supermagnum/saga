<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_disguise_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/help_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/voice_disguise_help"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/voice_disguise_mode"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/mode_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voice_disguise_mode_off" />

            <RadioButton
                android:id="@+id/mode_pitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voice_disguise_mode_pitch" />

            <RadioButton
                android:id="@+id/mode_formant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voice_disguise_mode_formant" />

            <RadioButton
                android:id="@+id/mode_formant_pitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voice_disguise_mode_formant_pitch" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/pitch_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/pitch_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voice_disguise_pitch"
                android:textStyle="bold" />

            <com.google.android.material.slider.Slider
                android:id="@+id/pitch_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="-6"
                android:valueTo="6"
                android:stepSize="1"
                android:value="-3"
                app:labelBehavior="floating" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/formant_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voice_disguise_formant"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/formant_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/formant_mild"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_disguise_formant_mild" />

                <RadioButton
                    android:id="@+id/formant_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_disguise_formant_medium" />

                <RadioButton
                    android:id="@+id/formant_strong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_disguise_formant_strong" />
            </RadioGroup>
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/random_each_call"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/voice_disguise_random_each_call" />

        <TextView
            android:id="@+id/fixed_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/voice_disguise_fixed_warning"
            android:textColor="#B71C1C"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/test_my_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/voice_disguise_test_my_voice" />

        <TextView
            android:id="@+id/test_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/voice_disguise_contact_override_section"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/voice_disguise_contact_override_help"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/voice_disguise_contact_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/contact_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <RadioGroup
            android:id="@+id/override_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/override_default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voice_disguise_override_default" />

            <RadioButton
                android:id="@+id/override_always_on"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voice_disguise_override_always_on" />

            <RadioButton
                android:id="@+id/override_always_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voice_disguise_override_always_off" />
        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_override"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/voice_disguise_save_override" />
    </LinearLayout>
</ScrollView>
