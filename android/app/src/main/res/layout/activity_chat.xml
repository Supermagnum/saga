<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/chat_padlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/msg_padlock_unknown"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/chat_disabled_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/msg_no_key"
        android:visibility="gone" />

    <EditText
        android:id="@+id/chat_peer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/msg_peer_hint"
        android:inputType="phone"
        android:visibility="gone" />

    <ListView
        android:id="@+id/chat_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:stackFromBottom="true"
        android:transcriptMode="alwaysScroll" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/chat_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/msg_input_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="4096" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/msg_send" />
    </LinearLayout>
</LinearLayout>
