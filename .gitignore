.ignore/
android/.gradle/
android/**/build/
android/local.properties
android/.idea/
saga-iroh-core/target/
saga-session/target/
saga-media/target/
testing/mock-token/target/
tools/saga-peer/target/
# Local unsigned/signed preview APKs — never commit binaries or keystores.
out/
*.jks
*.keystore
# Exception: curated verified builds under compiled/ (APK + SHA256SUMS + .asc).
!compiled/
!compiled/*.apk
!compiled/SHA256SUMS
!compiled/SHA256SUMS.asc
